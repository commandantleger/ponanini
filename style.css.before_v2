* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html, body {
    width: 100%;
    height: 100%;
}

body {
    overflow: hidden;
    background: #000;
    color: #e8dfc8;
    font-family: Georgia, "Times New Roman", serif;
}

#game {
    position: fixed;
    inset: 0;
    display: block;
    width: 100vw;
    height: 100vh;
    margin: 0;
    padding: 0;
    border: 0;
    image-rendering: pixelated;
    background: #000;
    z-index: 0;
}

/* =========================================================
   MENU : NOIR + GRANDE BOUCHE DANS L'OMBRE
========================================================= */

#menu {
    position: fixed;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: center;
    background: #000;
    color: #d8c9a3;
    z-index: 999;
    overflow: hidden;
    isolation: isolate;
    animation: menuFadeIn 1.2s ease forwards;
}

/* Halo presque invisible derrière la bouche */
#menu::before {
    content: "";
    position: absolute;
    width: min(900px, 80vw);
    height: min(500px, 55vh);
    left: 69%;
    top: 52%;
    transform: translate(-50%, -50%);
    background: radial-gradient(
        ellipse,
        rgba(74, 58, 43, .10) 0%,
        rgba(25, 20, 18, .045) 38%,
        transparent 72%
    );
    pointer-events: none;
    z-index: -3;
    animation: breathing 8s ease-in-out infinite;
}

/* La bouche : aucune tête, aucun œil, uniquement le sourire */
#menu::after {
    content: "";
    position: absolute;
    left: 69%;
    top: 51%;
    width: min(650px, 58vw);
    height: min(190px, 20vh);
    transform: translate(-50%, -50%);
    border-top: 8px solid rgba(137, 121, 94, .20);
    border-radius: 50% 50% 48% 48%;
    box-shadow:
        0 24px 50px rgba(0, 0, 0, .95),
        0 0 40px rgba(91, 65, 43, .035),
        inset 0 -20px 35px rgba(0, 0, 0, .9);
    opacity: .82;
    pointer-events: none;
    z-index: -1;
    animation: mouthBreath 7s ease-in-out infinite;
}

#menu h1 {
    position: relative;
    margin-top: 8vh;
    margin-bottom: 8px;
    font-size: clamp(42px, 5vw, 72px);
    font-weight: 700;
    letter-spacing: 5px;
    text-align: center;
    color: #d6b86d;
    text-shadow:
        0 0 10px rgba(210, 171, 87, .22),
        0 0 32px rgba(170, 125, 50, .08),
        2px 3px 4px rgba(0, 0, 0, .95);
    z-index: 5;
}

#menu h2 {
    position: relative;
    margin-bottom: 6vh;
    font-size: clamp(12px, 1.25vw, 17px);
    font-weight: normal;
    letter-spacing: 5px;
    text-transform: uppercase;
    color: rgba(196, 183, 153, .62);
    z-index: 5;
}

#menu h2::after {
    content: "◆";
    display: block;
    margin-top: 13px;
    font-size: 8px;
    color: rgba(200, 163, 89, .60);
}

#menu button {
    position: relative;
    width: min(390px, 72vw);
    min-height: 54px;
    margin: 6px;
    padding: 12px 30px;
    border: 1px solid rgba(154, 132, 88, .30);
    border-left: 2px solid rgba(154, 132, 88, .16);
    border-right: 2px solid rgba(154, 132, 88, .16);
    background: rgba(4, 4, 5, .70);
    color: rgba(207, 197, 174, .82);
    font: normal 18px Georgia, "Times New Roman", serif;
    letter-spacing: 3px;
    cursor: pointer;
    transition: .25s ease;
    z-index: 5;
}

#menu button:hover {
    color: #ecd79b;
    background: rgba(31, 26, 21, .82);
    border-color: rgba(205, 169, 91, .70);
    transform: translateX(5px);
    box-shadow: 0 0 22px rgba(170, 125, 50, .08);
}

#menu button:active {
    transform: translateX(5px) scale(.98);
}

/* Le bouton Quitter est retiré du menu principal */
#quitButton {
    display: none;
}

#menu .credits {
    position: absolute;
    bottom: 25px;
    left: 50%;
    transform: translateX(-50%);
    width: 90%;
    text-align: center;
    color: rgba(175, 164, 143, .30);
    font-size: 11px;
    line-height: 1.8;
    letter-spacing: 2px;
    z-index: 5;
}

/* =========================================================
   LOADING
========================================================= */

#loading-screen {
    position: fixed;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    background: #000;
    color: #d7b96d;
    z-index: 5000;
    opacity: 1;
    transition: opacity .6s ease;
}

#loading-screen.hidden {
    display: flex !important;
    opacity: 0;
    pointer-events: none;
}

#loading-title {
    font: bold 28px Georgia, serif;
    letter-spacing: 5px;
    margin-bottom: 24px;
}

#loading-bar {
    width: min(360px, 65vw);
    height: 3px;
    background: rgba(255,255,255,.12);
    overflow: hidden;
}

#loading-progress {
    width: 0%;
    height: 100%;
    background: #caa85c;
    transition: width .35s ease;
}

#loading-text {
    margin-top: 13px;
    font: 12px Georgia, serif;
    letter-spacing: 3px;
    color: rgba(220,210,188,.45);
}

/* =========================================================
   HUD
========================================================= */

#hud {
    position: fixed;
    top: 15px;
    left: 15px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 15px 20px;
    background: rgba(5,5,5,.72);
    color: white;
    border: 2px solid rgba(186,151,74,.7);
    border-radius: 4px;
    backdrop-filter: blur(5px);
    z-index: 100;
}

#life, #quest, #pieces {
    font-size: 18px;
    font-weight: bold;
}

/* =========================================================
   DIALOGUE
========================================================= */

#dialogue {
    position: fixed;
    left: 50%;
    bottom: 20px;
    transform: translateX(-50%);
    width: 78%;
    min-height: 140px;
    background: rgba(10,9,8,.96);
    color: white;
    border: 2px solid rgba(193,158,82,.85);
    border-radius: 4px;
    padding: 22px;
    z-index: 250;
    box-shadow: 0 0 35px rgba(0,0,0,.8);
}

#dialogueText {
    font-size: 24px;
    line-height: 1.5;
}

#dialogue span {
    float: right;
    margin-top: 15px;
    color: #d4b46b;
    font-weight: bold;
}

/* =========================================================
   INVENTAIRE
========================================================= */

#inventory {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%,-50%);
    width: 500px;
    min-height: 360px;
    background: #11100e;
    color: #e8dfcc;
    border: 3px solid #80683c;
    border-radius: 4px;
    padding: 25px;
    z-index: 400;
    box-shadow: 0 0 50px rgba(0,0,0,.8);
}

#inventory h2 {
    text-align: center;
    margin-bottom: 25px;
    color: #d5b66d;
}

#inventory ul {
    list-style: none;
}

#inventory li {
    font-size: 24px;
    margin: 15px 0;
    padding: 10px;
    border-bottom: 1px solid rgba(150,130,100,.25);
}

.hidden {
    display: none !important;
}

@keyframes menuFadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
}

@keyframes breathing {
    0%,100% { transform: translate(-50%,-50%) scale(1); opacity: .55; }
    50% { transform: translate(-50%,-50%) scale(1.05); opacity: .9; }
}

@keyframes mouthBreath {
    0%,100% { opacity: .38; transform: translate(-50%,-50%) scaleX(1); }
    50% { opacity: .72; transform: translate(-50%,-50%) scaleX(1.025); }
}

@media (max-width: 800px) {
    #menu h1 { font-size: 38px; letter-spacing: 3px; }
    #menu h2 { font-size: 10px; letter-spacing: 3px; }
    #menu button { width: 76vw; font-size: 15px; }
    #menu::after { left: 72%; opacity: .55; }
}

/* =========================================================
   PONAN'S LEGACY — NOUVEAU MENU PRINCIPAL
========================================================= */

#menu {

    position: fixed;

    inset: 0;

    width: 100vw;
    height: 100vh;

    overflow: hidden;

    background:
        radial-gradient(
            circle at 72% 42%,
            rgba(104, 82, 35, 0.18),
            transparent 35%
        ),
        radial-gradient(
            circle at 20% 80%,
            rgba(25, 50, 60, 0.22),
            transparent 40%
        ),
        linear-gradient(
            115deg,
            #050709 0%,
            #0b0f12 45%,
            #050608 100%
        );

    z-index: 5000;

    transition:
        opacity 0.8s ease,
        visibility 0.8s ease;
}


/* =========================================================
   AMBIANCE
========================================================= */

#menu::before {

    content: "";

    position: absolute;

    inset: 0;

    background:
        radial-gradient(
            ellipse at 78% 48%,
            rgba(190, 155, 70, 0.10),
            transparent 25%
        );

    pointer-events: none;
}


#menu::after {

    content: "";

    position: absolute;

    inset: 0;

    opacity: 0.25;

    background-image:
        radial-gradient(
            circle,
            rgba(220, 190, 110, 0.35) 1px,
            transparent 1px
        );

    background-size:
        85px 85px;

    animation:
        menuParticles 18s linear infinite;

    pointer-events: none;
}


@keyframes menuParticles {

    from {
        transform:
            translateY(0);
    }

    to {
        transform:
            translateY(-85px);
    }
}


/* =========================================================
   OVERLAY EXISTANT
========================================================= */

#menu .menu-overlay {

    position: absolute;

    inset: 0;

    background:
        linear-gradient(
            90deg,
            rgba(0, 0, 0, 0.78) 0%,
            rgba(0, 0, 0, 0.48) 42%,
            rgba(0, 0, 0, 0.12) 100%
        );

    pointer-events: none;
}


/* =========================================================
   CONTENU
========================================================= */

#menu .menu-content {

    position: relative;

    z-index: 2;

    width: 460px;

    min-height: 100vh;

    padding:
        9vh 0 7vh 9vw;

    display: flex;

    flex-direction: column;

    justify-content: center;

    align-items: flex-start;

    box-sizing: border-box;
}


/* =========================================================
   LOGO
========================================================= */

#menu .menu-logo {

    text-align: left;

    margin-bottom: 52px;

    position: relative;
}


#menu .logo-duck {

    display: none;
}


#menu .menu-logo h1 {

    margin: 0;

    color:
        #eee7d7;

    font-family:
        Georgia,
        "Times New Roman",
        serif;

    font-size:
        clamp(42px, 5vw, 72px);

    font-weight:
        400;

    letter-spacing:
        7px;

    line-height:
        0.95;

    text-shadow:
        0 0 35px
        rgba(190, 155, 70, 0.20);
}


#menu .menu-logo h2 {

    margin:
        16px 0 0;

    color:
        #b9973e;

    font-family:
        Georgia,
        serif;

    font-size:
        15px;

    font-weight:
        400;

    letter-spacing:
        5px;

    text-transform:
        uppercase;
}


#menu .logo-line {

    width:
        260px;

    height:
        1px;

    margin-top:
        25px;

    background:
        linear-gradient(
            90deg,
            #b9973e,
            rgba(185,151,62,0)
        );
}


/* =========================================================
   BOUTONS
========================================================= */

#menu .menu-buttons {

    width:
        340px;

    display:
        flex;

    flex-direction:
        column;

    gap:
        4px;

    margin-bottom:
        55px;
}


#menu .menu-buttons button {

    position:
        relative;

    width:
        100%;

    min-height:
        52px;

    padding:
        0 22px;

    display:
        flex;

    align-items:
        center;

    gap:
        18px;

    border:
        0;

    border-left:
        1px solid
        transparent;

    background:
        transparent;

    color:
        rgba(238, 231, 215, 0.68);

    font-family:
        Georgia,
        serif;

    font-size:
        14px;

    font-weight:
        400;

    letter-spacing:
        2px;

    text-align:
        left;

    cursor:
        pointer;

    transition:
        all 0.25s ease;
}


#menu .menu-buttons button span {

    width:
        18px;

    color:
        #b9973e;

    font-size:
        12px;

    opacity:
        0.65;

    transition:
        transform 0.25s ease,
        opacity 0.25s ease;
}


#menu .menu-buttons button:hover {

    color:
        #eee7d7;

    background:
        linear-gradient(
            90deg,
            rgba(185,151,62,0.12),
            transparent
        );

    border-left:
        1px solid
        #b9973e;

    padding-left:
        28px;
}


#menu .menu-buttons button:hover span {

    opacity:
        1;

    transform:
        translateX(3px);
}


#menu .menu-buttons button:active {

    transform:
        translateX(2px);
}


#menu .menu-buttons button:disabled {

    opacity:
        0.45;

    cursor:
        default;
}


/* =========================================================
   TEXTE HISTOIRE
========================================================= */

#menu .menu-story {

    position:
        absolute;

    left:
        9vw;

    bottom:
        9vh;

    margin:
        0;

    padding-left:
        18px;

    border-left:
        1px solid
        rgba(185,151,62,0.45);

    color:
        rgba(238,231,215,0.42);

    font-family:
        Georgia,
        serif;

    font-size:
        12px;

    line-height:
        1.8;

    letter-spacing:
        1px;
}


#menu .menu-story p {

    margin:
        0;
}


#menu .menu-story p:first-child {

    color:
        rgba(238,231,215,0.65);
}


/* =========================================================
   VERSION
========================================================= */

#menu .menu-version {

    position:
        absolute;

    right:
        35px;

    bottom:
        25px;

    color:
        rgba(238,231,215,0.22);

    font-family:
        Arial,
        sans-serif;

    font-size:
        9px;

    letter-spacing:
        3px;
}


/* =========================================================
   MENU HIDE
========================================================= */

#menu.menu-hide {

    opacity:
        0;

    pointer-events:
        none;

    visibility:
        hidden;
}


/* =========================================================
   RESPONSIVE
========================================================= */

@media (max-width: 800px) {

    #menu .menu-content {

        width:
            100%;

        padding:
            8vh 8vw;
    }


    #menu .menu-logo h1 {

        font-size:
            40px;

        letter-spacing:
            4px;
    }


    #menu .menu-buttons {

        width:
            min(340px, 85vw);
    }


    #menu .menu-story {

        left:
            8vw;

        bottom:
            5vh;
    }
}

/* =========================================================
   PONAN'S LEGACY
   MENU CINÉMATIQUE V2
========================================================= */

#menu {

    position: fixed;
    inset: 0;

    width: 100vw;
    height: 100vh;

    overflow: hidden;

    background: #050608;

    z-index: 5000;

    opacity: 1;

    transition:
        opacity 1s ease,
        visibility 1s ease;
}


/* =========================================================
   IMAGE DE FOND
========================================================= */

#menu::before {

    content: "";

    position: absolute;

    inset: -35px;

    background-image:
        var(--menu-background);

    background-size: cover;
    background-position:
        calc(50% + var(--parallax-x, 0px))
        calc(50% + var(--parallax-y, 0px));

    transform:
        scale(1.08);

    filter:
        brightness(0.58)
        saturate(0.82);

    transition:
        background-position 0.25s ease-out;

    z-index: 0;
}


/* =========================================================
   BRUME / PROFONDEUR
========================================================= */

#menu .menu-overlay {

    position: absolute;

    inset: 0;

    z-index: 1;

    background:

        linear-gradient(
            90deg,
            rgba(2, 5, 7, 0.96) 0%,
            rgba(3, 7, 9, 0.88) 25%,
            rgba(3, 7, 9, 0.55) 52%,
            rgba(3, 7, 9, 0.15) 100%
        ),

        linear-gradient(
            0deg,
            rgba(0, 0, 0, 0.72) 0%,
            transparent 38%,
            rgba(0, 0, 0, 0.20) 100%
        );
}


/* =========================================================
   HALO DORÉ
========================================================= */

#menu::after {

    content: "";

    position: absolute;

    width: 600px;
    height: 600px;

    right: 5%;
    top: 50%;

    transform:
        translateY(-50%);

    background:
        radial-gradient(
            circle,
            rgba(190, 155, 70, 0.13) 0%,
            rgba(190, 155, 70, 0.04) 35%,
            transparent 70%
        );

    filter:
        blur(12px);

    z-index: 1;

    pointer-events: none;

    animation:
        menuGlow 6s ease-in-out infinite;
}


@keyframes menuGlow {

    0%,
    100% {
        opacity: 0.55;
        transform:
            translateY(-50%)
            scale(0.96);
    }

    50% {
        opacity: 1;
        transform:
            translateY(-50%)
            scale(1.04);
    }
}


/* =========================================================
   CONTENU
========================================================= */

#menu .menu-content {

    position: relative;

    z-index: 3;

    width: 460px;

    height: 100%;

    box-sizing: border-box;

    padding-left: 9vw;

    display: flex;

    flex-direction: column;

    justify-content: center;

    align-items: flex-start;
}


/* =========================================================
   LOGO
========================================================= */

#menu .logo-duck {
    display: none;
}


#menu .menu-logo {

    position: relative;

    margin-bottom: 48px;

    text-align: left;

    animation:
        menuTitleIn 1.4s
        cubic-bezier(.22,1,.36,1)
        both;
}


@keyframes menuTitleIn {

    from {
        opacity: 0;
        transform:
            translateY(28px);
        filter:
            blur(8px);
    }

    to {
        opacity: 1;
        transform:
            translateY(0);
        filter:
            blur(0);
    }
}


#menu .menu-logo h1 {

    margin: 0;

    color:
        #eee8da;

    font-family:
        Georgia,
        "Times New Roman",
        serif;

    font-size:
        clamp(42px, 5vw, 70px);

    font-weight:
        400;

    letter-spacing:
        7px;

    line-height:
        0.92;

    text-shadow:
        0 0 30px
        rgba(190,155,70,0.18);
}


#menu .menu-logo h2 {

    margin:
        17px 0 0;

    color:
        #b9973e;

    font-family:
        Georgia,
        serif;

    font-size:
        14px;

    font-weight:
        400;

    letter-spacing:
        5px;

    text-transform:
        uppercase;
}


#menu .logo-line {

    width:
        250px;

    height:
        1px;

    margin-top:
        24px;

    background:
        linear-gradient(
            90deg,
            #b9973e,
            rgba(185,151,62,0)
        );
}


/* =========================================================
   MENU BUTTONS
========================================================= */

#menu .menu-buttons {

    width:
        350px;

    display:
        flex;

    flex-direction:
        column;

    gap:
        2px;

    animation:
        menuButtonsIn 1.2s
        0.25s
        cubic-bezier(.22,1,.36,1)
        both;
}


@keyframes menuButtonsIn {

    from {
        opacity: 0;
        transform:
            translateY(20px);
    }

    to {
        opacity: 1;
        transform:
            translateY(0);
    }
}


#menu .menu-buttons button {

    position:
        relative;

    width:
        100%;

    height:
        52px;

    padding:
        0 18px;

    border:
        0;

    border-left:
        1px solid
        transparent;

    background:
        transparent;

    color:
        rgba(238,232,218,0.62);

    font-family:
        Georgia,
        serif;

    font-size:
        14px;

    letter-spacing:
        2px;

    text-align:
        left;

    cursor:
        pointer;

    transition:
        color 0.25s ease,
        background 0.25s ease,
        border-color 0.25s ease,
        padding-left 0.25s ease;
}


#menu .menu-buttons button::after {

    content: "";

    position:
        absolute;

    left:
        0;

    bottom:
        0;

    width:
        0;

    height:
        1px;

    background:
        linear-gradient(
            90deg,
            #b9973e,
            transparent
        );

    transition:
        width 0.3s ease;
}


#menu .menu-buttons button:hover {

    color:
        #f2ead9;

    background:
        linear-gradient(
            90deg,
            rgba(185,151,62,0.12),
            transparent
        );

    border-left:
        1px solid
        #b9973e;

    padding-left:
        27px;
}


#menu .menu-buttons button:hover::after {

    width:
        100%;
}


#menu .menu-buttons button span {

    display:
        inline-block;

    width:
        20px;

    color:
        #b9973e;

    font-size:
        11px;

    opacity:
        0.7;

    transition:
        transform 0.25s ease,
        opacity 0.25s ease;
}


#menu .menu-buttons button:hover span {

    opacity:
        1;

    transform:
        translateX(3px);
}


/* =========================================================
   TEXTE NARRATIF
========================================================= */

#menu .menu-story {

    position:
        absolute;

    left:
        9vw;

    bottom:
        7vh;

    margin:
        0;

    padding-left:
        18px;

    border-left:
        1px solid
        rgba(185,151,62,0.45);

    color:
        rgba(238,232,218,0.42);

    font-family:
        Georgia,
        serif;

    font-size:
        11px;

    line-height:
        1.9;

    letter-spacing:
        1.2px;

    animation:
        storyIn 1.5s
        0.6s
        both;
}


@keyframes storyIn {

    from {
        opacity: 0;
        transform:
            translateY(10px);
    }

    to {
        opacity: 1;
        transform:
            translateY(0);
    }
}


#menu .menu-story p {
    margin: 0;
}


#menu .menu-story p:first-child {
    color:
        rgba(238,232,218,0.72);
}


/* =========================================================
   VERSION
========================================================= */

#menu .menu-version {

    position:
        absolute;

    right:
        28px;

    bottom:
        22px;

    color:
        rgba(238,232,218,0.22);

    font-family:
        Arial,
        sans-serif;

    font-size:
        8px;

    letter-spacing:
        3px;
}


/* =========================================================
   PARTICULES
========================================================= */

#menu .menu-particles {

    position:
        absolute;

    inset:
        0;

    z-index:
        2;

    pointer-events:
        none;

    overflow:
        hidden;
}


#menu .menu-particles::before {

    content:
        "✦     ·          ·       ✦          ·        ·     ✦";

    position:
        absolute;

    width:
        100%;

    height:
        100%;

    color:
        rgba(211,180,105,0.18);

    font-size:
        12px;

    letter-spacing:
        45px;

    line-height:
        110px;

    animation:
        particlesFloat 16s
        linear infinite;

    white-space:
        pre-wrap;
}


@keyframes particlesFloat {

    from {
        transform:
            translateY(0);
    }

    to {
        transform:
            translateY(-110px);
    }
}


/* =========================================================
   DISPARITION
========================================================= */

#menu.menu-hide {

    opacity:
        0;

    visibility:
        hidden;

    pointer-events:
        none;
}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 800px) {

    #menu .menu-content {

        width:
            100%;

        padding:
            0 8vw;

    }


    #menu .menu-logo h1 {

        font-size:
            42px;

        letter-spacing:
            4px;
    }


    #menu .menu-buttons {

        width:
            min(350px, 84vw);
    }


    #menu .menu-story {

        left:
            8vw;

        bottom:
            4vh;
    }
}


/* ==========================================================
   PONAN'S LEGACY — GAMEPLAY UPGRADE UI
========================================================== */

#upgrade-hud {
    position: fixed;
    right: 22px;
    top: 22px;
    width: 190px;
    padding: 10px 12px;
    z-index: 1000;
    pointer-events: none;
    color: #eee8d0;
    background: rgba(10, 18, 14, 0.78);
    border: 1px solid rgba(210, 184, 92, 0.55);
    box-shadow:
        0 8px 28px rgba(0, 0, 0, 0.38),
        inset 0 0 24px rgba(210, 184, 92, 0.04);
    backdrop-filter: blur(5px);
    font-family: Georgia, "Times New Roman", serif;
    letter-spacing: 0.08em;
}

#upgrade-hud .upgrade-row {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    font-size: 11px;
    margin-bottom: 7px;
}

#upgrade-speed {
    color: #d8bd5b;
}

.upgrade-stamina {
    height: 4px;
    overflow: hidden;
    background: rgba(255,255,255,0.10);
}

#upgrade-stamina-fill {
    height: 100%;
    width: 100%;
    background: linear-gradient(
        90deg,
        #8d7a34,
        #e4c968
    );
    transition: width 120ms linear;
}

.upgrade-tip {
    margin-top: 7px;
    font-size: 8px;
    opacity: 0.58;
    letter-spacing: 0.05em;
}

#upgrade-toast {
    position: fixed;
    left: 50%;
    bottom: 90px;
    transform: translate(-50%, 12px);
    z-index: 1100;
    padding: 9px 16px;
    color: #f4e8bc;
    background: rgba(12, 14, 12, 0.9);
    border: 1px solid rgba(210, 184, 92, 0.6);
    font-family: Georgia, "Times New Roman", serif;
    font-size: 13px;
    opacity: 0;
    pointer-events: none;
    transition:
        opacity 180ms ease,
        transform 180ms ease;
}

#upgrade-toast.show {
    opacity: 1;
    transform: translate(-50%, 0);
}

