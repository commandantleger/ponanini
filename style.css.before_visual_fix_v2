* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html, body {
    width: 100%;
    height: 100%;
}

body {
    overflow: hidden;
    background: #000;
    color: #e8dfc8;
    font-family: Georgia, "Times New Roman", serif;
}

#game {
    position: fixed;
    inset: 0;
    display: block;
    width: 100vw;
    height: 100vh;
    margin: 0;
    padding: 0;
    border: 0;
    image-rendering: pixelated;
    background: #000;
    z-index: 0;
}

/* =========================================================
   MENU : NOIR + GRANDE BOUCHE DANS L'OMBRE
========================================================= */

#menu {
    position: fixed;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: center;
    background: #000;
    color: #d8c9a3;
    z-index: 999;
    overflow: hidden;
    isolation: isolate;
    animation: menuFadeIn 1.2s ease forwards;
}

/* Halo presque invisible derrière la bouche */
#menu::before {
    content: "";
    position: absolute;
    width: min(900px, 80vw);
    height: min(500px, 55vh);
    left: 69%;
    top: 52%;
    transform: translate(-50%, -50%);
    background: radial-gradient(
        ellipse,
        rgba(74, 58, 43, .10) 0%,
        rgba(25, 20, 18, .045) 38%,
        transparent 72%
    );
    pointer-events: none;
    z-index: -3;
    animation: breathing 8s ease-in-out infinite;
}

/* La bouche : aucune tête, aucun œil, uniquement le sourire */
#menu::after {
    content: "";
    position: absolute;
    left: 69%;
    top: 51%;
    width: min(650px, 58vw);
    height: min(190px, 20vh);
    transform: translate(-50%, -50%);
    border-top: 8px solid rgba(137, 121, 94, .20);
    border-radius: 50% 50% 48% 48%;
    box-shadow:
        0 24px 50px rgba(0, 0, 0, .95),
        0 0 40px rgba(91, 65, 43, .035),
        inset 0 -20px 35px rgba(0, 0, 0, .9);
    opacity: .82;
    pointer-events: none;
    z-index: -1;
    animation: mouthBreath 7s ease-in-out infinite;
}

#menu h1 {
    position: relative;
    margin-top: 8vh;
    margin-bottom: 8px;
    font-size: clamp(42px, 5vw, 72px);
    font-weight: 700;
    letter-spacing: 5px;
    text-align: center;
    color: #d6b86d;
    text-shadow:
        0 0 10px rgba(210, 171, 87, .22),
        0 0 32px rgba(170, 125, 50, .08),
        2px 3px 4px rgba(0, 0, 0, .95);
    z-index: 5;
}

#menu h2 {
    position: relative;
    margin-bottom: 6vh;
    font-size: clamp(12px, 1.25vw, 17px);
    font-weight: normal;
    letter-spacing: 5px;
    text-transform: uppercase;
    color: rgba(196, 183, 153, .62);
    z-index: 5;
}

#menu h2::after {
    content: "◆";
    display: block;
    margin-top: 13px;
    font-size: 8px;
    color: rgba(200, 163, 89, .60);
}

#menu button {
    position: relative;
    width: min(390px, 72vw);
    min-height: 54px;
    margin: 6px;
    padding: 12px 30px;
    border: 1px solid rgba(154, 132, 88, .30);
    border-left: 2px solid rgba(154, 132, 88, .16);
    border-right: 2px solid rgba(154, 132, 88, .16);
    background: rgba(4, 4, 5, .70);
    color: rgba(207, 197, 174, .82);
    font: normal 18px Georgia, "Times New Roman", serif;
    letter-spacing: 3px;
    cursor: pointer;
    transition: .25s ease;
    z-index: 5;
}

#menu button:hover {
    color: #ecd79b;
    background: rgba(31, 26, 21, .82);
    border-color: rgba(205, 169, 91, .70);
    transform: translateX(5px);
    box-shadow: 0 0 22px rgba(170, 125, 50, .08);
}

#menu button:active {
    transform: translateX(5px) scale(.98);
}

/* Le bouton Quitter est retiré du menu principal */
#quitButton {
    display: none;
}

#menu .credits {
    position: absolute;
    bottom: 25px;
    left: 50%;
    transform: translateX(-50%);
    width: 90%;
    text-align: center;
    color: rgba(175, 164, 143, .30);
    font-size: 11px;
    line-height: 1.8;
    letter-spacing: 2px;
    z-index: 5;
}

/* =========================================================
   LOADING
========================================================= */

#loading-screen {
    position: fixed;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    background: #000;
    color: #d7b96d;
    z-index: 5000;
    opacity: 1;
    transition: opacity .6s ease;
}

#loading-screen.hidden {
    display: flex !important;
    opacity: 0;
    pointer-events: none;
}

#loading-title {
    font: bold 28px Georgia, serif;
    letter-spacing: 5px;
    margin-bottom: 24px;
}

#loading-bar {
    width: min(360px, 65vw);
    height: 3px;
    background: rgba(255,255,255,.12);
    overflow: hidden;
}

#loading-progress {
    width: 0%;
    height: 100%;
    background: #caa85c;
    transition: width .35s ease;
}

#loading-text {
    margin-top: 13px;
    font: 12px Georgia, serif;
    letter-spacing: 3px;
    color: rgba(220,210,188,.45);
}

/* =========================================================
   HUD
========================================================= */

#hud {
    position: fixed;
    top: 15px;
    left: 15px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 15px 20px;
    background: rgba(5,5,5,.72);
    color: white;
    border: 2px solid rgba(186,151,74,.7);
    border-radius: 4px;
    backdrop-filter: blur(5px);
    z-index: 100;
}

#life, #quest, #pieces {
    font-size: 18px;
    font-weight: bold;
}

/* =========================================================
   DIALOGUE
========================================================= */

#dialogue {
    position: fixed;
    left: 50%;
    bottom: 20px;
    transform: translateX(-50%);
    width: 78%;
    min-height: 140px;
    background: rgba(10,9,8,.96);
    color: white;
    border: 2px solid rgba(193,158,82,.85);
    border-radius: 4px;
    padding: 22px;
    z-index: 250;
    box-shadow: 0 0 35px rgba(0,0,0,.8);
}

#dialogueText {
    font-size: 24px;
    line-height: 1.5;
}

#dialogue span {
    float: right;
    margin-top: 15px;
    color: #d4b46b;
    font-weight: bold;
}

/* =========================================================
   INVENTAIRE
========================================================= */

#inventory {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%,-50%);
    width: 500px;
    min-height: 360px;
    background: #11100e;
    color: #e8dfcc;
    border: 3px solid #80683c;
    border-radius: 4px;
    padding: 25px;
    z-index: 400;
    box-shadow: 0 0 50px rgba(0,0,0,.8);
}

#inventory h2 {
    text-align: center;
    margin-bottom: 25px;
    color: #d5b66d;
}

#inventory ul {
    list-style: none;
}

#inventory li {
    font-size: 24px;
    margin: 15px 0;
    padding: 10px;
    border-bottom: 1px solid rgba(150,130,100,.25);
}

.hidden {
    display: none !important;
}

@keyframes menuFadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
}

@keyframes breathing {
    0%,100% { transform: translate(-50%,-50%) scale(1); opacity: .55; }
    50% { transform: translate(-50%,-50%) scale(1.05); opacity: .9; }
}

@keyframes mouthBreath {
    0%,100% { opacity: .38; transform: translate(-50%,-50%) scaleX(1); }
    50% { opacity: .72; transform: translate(-50%,-50%) scaleX(1.025); }
}

@media (max-width: 800px) {
    #menu h1 { font-size: 38px; letter-spacing: 3px; }
    #menu h2 { font-size: 10px; letter-spacing: 3px; }
    #menu button { width: 76vw; font-size: 15px; }
    #menu::after { left: 72%; opacity: .55; }
}
